# Prevent execution of any scripts in the cache directory
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
